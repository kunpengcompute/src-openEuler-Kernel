+	__iee_si_text_end = .;	\
+	. += PMD_SIZE;
+#else
+#define IEE_SI_TEXT
+#endif
+
+#ifdef CONFIG_IEE
+#define IEE_TEXT \
+	. = ALIGN(PAGE_SIZE);				\
+	__iee_code_start = .;       \
+	*(.iee.text)				        \
+	. = ALIGN(PAGE_SIZE);				\
+	__iee_code_end = .;			\
+	IEE_SI_TEXT
+#else
