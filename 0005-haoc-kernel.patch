-
-	/* only track the matched UTS namespace */
-	if (!_target_process(current->nsproxy->uts_ns->name.nodename))
-		return;
-
-	switch (tag) {
-	case TAG_READ:
-		bpf_tracker_rio_read(addr1, addr2);
-		break;
-	case TAG_PRE_FAULT:
-		bpf_tracker_rio_pre_fault(addr1);
-		break;
-	case TAG_POST_FAULT:
-		bpf_tracker_rio_post_fault(addr1);
-		break;
-	}
-}
-
-__diag_pop();
