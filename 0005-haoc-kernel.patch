 #define TCR_A1			(UL(1) << 22)
 #define IEE_TCR_MASK		(~(TCR_HD | TCR_E0PD1 | TCR_T0SZ_MASK))
 
+#ifdef CONFIG_IEE_SIP
+/* IEE exit code Remember that ARM instructions are aligned with 8 byte. */
+#define IEE_SI_EXIT_OFFSET	(4*4)
+#define IEE_SI_TCR_MASK		(~IEE_TCR_MASK)
+#endif
+
+#ifdef __ASSEMBLY__
+	/* IEE code shall not be interrupted. */
+	.macro iee_elr_check
+	ldr x1, =__iee_code_start
+	cmp x1, x22			/* ELR_EL1 was stored in x22 on kernel entry. */
+	b.hi 114f
+	#ifdef CONFIG_IEE_SIP
+	ldr x2, =__iee_si_text_end
+	#else
+	ldr x2, =__iee_code_end
+	#endif
+	cmp x2, x22
+	b.lo 114f
+	/* ELR check fail */
+	mov	x0, sp
+	mov	x1, #BAD_ELR_EL1
+	mrs	x2, esr_el1
+	mov x3, x22
+	bl	iee_bad_mode
+	ASM_BUG()
+114:
+	.endm
+#endif
+
 #endif
