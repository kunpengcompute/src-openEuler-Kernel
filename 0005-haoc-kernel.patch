+#ifdef CONFIG_IEE_SIP
+#define IEE_SI_TEXT	\
+	. = ALIGN(PAGE_SIZE);	\
+	. += PMD_SIZE;		\
+	__iee_si_text_start = .;	\
+	*(.iee.si_text)	\
