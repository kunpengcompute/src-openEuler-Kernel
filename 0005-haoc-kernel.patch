+{
+	iee_rw_gate(IEE_OP_SET_TOKEN_PGD, tsk, pgd);
+}
+
+static inline void iee_init_token(struct task_struct *tsk)
+{
+	iee_rw_gate(IEE_OP_INIT_TOKEN, tsk);
+}
