-	loff_t foff;
-
-	filp = iocb->ki_filp;
-	count = iov_iter_count(to);
-	foff = (iocb->ki_pos >> PAGE_SHIFT) << PAGE_SHIFT;
-	size = ((count >> PAGE_SHIFT) + 1) << PAGE_SHIFT;
-	mark_rio(filp, foff, size);
-}
