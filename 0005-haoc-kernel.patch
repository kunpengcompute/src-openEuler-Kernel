+	__iee_ptp_data_start = .;	\
+	*(.iee.ptp)					\
+	. = ALIGN(PAGE_SIZE);		\
+	__iee_ptp_data_end = .;
+#else
+#define PTP_DATA
+#endif
+
+#ifdef CONFIG_IEE
+#define IEE_INIT_DATA \
+	.iee.data : {		\
+	. = ALIGN(PAGE_SIZE);		\
+	iee_init_data_begin = .;	\
