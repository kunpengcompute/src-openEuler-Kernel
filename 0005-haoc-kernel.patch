-	size_t can_read = 0;
-
-	list_for_each(tmp, &obj->head) {
-		io = list_entry(tmp, struct trace_io, link);
-		/* next bigger one */
-		if (io->doff + io->len <= off)
-			continue;
-
-		/* last unmatch one */
-		if (off + len <= io->doff)
-			break;
